#
# Daily re-scan. New CVEs are published against unchanged dependencies every
# day, so a periodic re-scan of the same SBOM is the point — not a rebuild.

[Unit]
Description=Daily grype-verify SBOM vulnerability re-scan
Documentation=https://github.com/sandlbn/grype-verify

[Timer]
# Every day at 03:00 local time.
OnCalendar=*-*-* 03:00:00

# Spread load and avoid every host hitting the Anchore CDN at the same second.
RandomizedDelaySec=30m

# If the machine was off at 03:00, run once it comes back up.
Persistent=true

Unit=grype-verify-scan.service

[Install]
WantedBy=timers.target
