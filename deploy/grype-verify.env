# Shared configuration for the systemd units. Install to /etc/grype-verify.env.
# Values below are the defaults baked into scan-all.sh — override as needed.

# Where the SBOMs to re-scan live. Whatever produces them (syft, CI artifact
# download, an rsync job) should drop *.spdx.json files here.
SBOM_DIR=/var/lib/grype-verify/sboms

# Embedded results database — shared by the scan timer and the API service.
GRYPE_CHECKS_DB=/var/lib/grype-verify/grype-checks.db

# grype vulnerability DB cache. Persisting this is what makes offline scans work.
GRYPE_DB_CACHE_DIR=/var/lib/grype-verify/grype-db

# Severity threshold that marks a scan "vulnerable".
FAIL_ON=high

# Uncomment to also emit a SARIF report per SBOM for GitHub Code Scanning.
#SARIF_DIR=/var/lib/grype-verify/sarif

# REST API bind address and port (grype-verify-api.service).
# Use 0.0.0.0 only if Splunk polls from another host.
API_BIND=127.0.0.1
API_PORT=8080
